{
  "name": "committide",
  "version": "0.1.0",
  "description": "Commit message validation, staged message writing, and release notes for the command line",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "author": {
    "name": "S. Adnan",
    "url": "https://s-adnan.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/S-Adnan-11/committide.git"
  },
  "homepage": "https://github.com/S-Adnan-11/committide#readme",
  "bugs": {
    "url": "https://github.com/S-Adnan-11/committide/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "committide": "dist/cli.js"
  },
  "files": [
    "dist/*.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "verify:package": "npm run build && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}

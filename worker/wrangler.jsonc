{
  "name": "committide-draft-preview",
  "main": "entry.mjs",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "HOSTED_ENABLED": "false",
    "ADMISSION_CAP": "2",
    "MODEL": "@cf/zai-org/glm-4.7-flash"
  },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "ADMISSION", "class_name": "Admission" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Admission"] }],
  "ratelimits": [{ "name": "BURST", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }]
}
